{
  "name": "@lifedashboard/widget-sdk",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Widget SDK and build CLI for LifeDashboard",
  "type": "module",
  "files": ["dist", "docs"],
  "exports": {
    ".": "./src/index.ts",
    "./host": "./src/host.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "ld-widget": "./src/cli.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/types/widget-sdk/src/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "bin": {
      "ld-widget": "./dist/cli.js"
    },
    "types": "./dist/types/widget-sdk/src/index.d.ts"
  },
  "scripts": {
    "dev": "vite build --watch",
    "docs": "node scripts/docs.ts",
    "build": "node scripts/build.ts",
    "prepack": "node scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "6.0.9",
    "vite": "8.3.2"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@lifedashboard/contracts": "workspace:*",
    "@types/node": "24.19.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "vue": "3.5.43"
  }
}
